[Unit]
Description=obs-stack edge Prometheus (WSL-side scraper that remote_writes into the cluster)
After=network.target

[Service]
Type=simple
# Path is generated by scripts/edge-prometheus.sh from
# monitoring/scrape/edge-prom.tpl.yaml + $OBS_STATE/host-targets.yaml.
ExecStart=@OBS_BIN@/prometheus --config.file=@OBS_STATE@/edge-prometheus.yaml --storage.tsdb.path=@OBS_STATE@/edge-prom --storage.tsdb.retention.time=24h --web.listen-address=0.0.0.0:@EDGE_PROM_PORT@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
